#!/bin/bash
cd "$(dirname "$0")" || exit 1

echo ""
echo "=============================================="
echo "  НАСТРОЙКА ФИНАНСОВОГО БОТА"
echo "=============================================="
echo ""

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js не найден на компьютере."
  echo ""
  echo "Откройте сайт nodejs.org, скачайте версию LTS, установите её,"
  echo "перезапустите компьютер и откройте этот файл снова."
  echo ""
  read -n 1 -s -r -p "Нажмите любую клавишу, чтобы закрыть..."
  exit 1
fi

node setup.mjs

echo ""
echo "Готово. Теперь закройте это окно и откройте файл: 2-ЗАПУСК-Mac.command"
echo ""
read -n 1 -s -r -p "Нажмите любую клавишу, чтобы закрыть..."
