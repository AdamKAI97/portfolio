{
  "name": "finbot-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot + REST API for personal finance tracking",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "2.8.5",
    "dayjs": "1.11.13",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "node-cron": "3.0.3",
    "telegraf": "4.16.3"
  },
  "devDependencies": {
    "nodemon": "3.1.9",
    "prisma": "5.22.0"
  }
}
