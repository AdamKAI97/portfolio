# ---- PostgreSQL (Neon) ----
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---- Telegram ----
BOT_TOKEN="1234567890:AAaaBBbbCCccDDddEEeeFFggHHiiJJkkLL"

# Ссылка на Mini App. Для localhost-теста в браузере оставьте http://localhost:5173,
# для Telegram подставьте https-адрес из ngrok.
WEBAPP_URL="http://localhost:5173"

# ---- Server ----
PORT=4000
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ---- Admin panel ----
ADMIN_TOKEN="change-me-admin-token"

# ---- Defaults ----
DEFAULT_LANGUAGE="ru"
DEFAULT_CURRENCY="UZS"
DEFAULT_TIMEZONE="Asia/Tashkent"

# Разрешить открывать Mini App в обычном браузере без подписи Telegram (только для локальной разработки)
ALLOW_DEV_AUTH="true"
DEV_TELEGRAM_ID=""
